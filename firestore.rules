rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de usuário — qualquer autenticado pode ler (para busca de amigos)
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Cartões de crédito — apenas o próprio dono
    match /cartoes/{cartaoId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Despesas
    match /despesas/{despesaId} {
      // Leitura: criador, participante do rateio ou destinatário de despesa compartilhada
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in resource.data.rateioParticipantesIds ||
        request.auth.uid in resource.data.compartilhadoComIds
      );

      // Criação: apenas o próprio usuário
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;

      // Update: criador pode tudo; participante só pode atualizar rateio e atualizadoEm
      allow update: if request.auth != null && (
        // Criador tem acesso total
        request.auth.uid == resource.data.userId
        ||
        // Participante pode responder ao rateio e registrar pagamento da sua parte
        (
          request.auth.uid in resource.data.rateioParticipantesIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rateio', 'atualizadoEm']) &&
          // Não pode desativar o rateio
          request.resource.data.rateio.ativo == resource.data.rateio.ativo &&
          // Não pode mudar o tipo de cálculo
          request.resource.data.rateio.get('tipo', null) == resource.data.rateio.get('tipo', null) &&
          // Não pode adicionar nem remover participantes
          request.resource.data.rateio.participantes.size() == resource.data.rateio.participantes.size()
        )
        ||
        // Destinatário de despesa compartilhada pode responder (aceitar/recusar)
        (
          request.auth.uid in resource.data.compartilhadoComIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['statusCompartilhamento', 'atualizadoEm'])
        )
      );

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // Caixinhas
    match /caixinhas/{caixinhaId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Receitas
    match /receitas/{receitaId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Amizades
    match /amizades/{amizadeId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.solicitanteId ||
        request.auth.uid == resource.data.receptorId
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.solicitanteId;
      // Receptor pode aceitar/recusar; solicitante não pode auto-aceitar
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.receptorId;
    }
  }
}