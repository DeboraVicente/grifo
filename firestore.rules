rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de usuário — qualquer autenticado pode ler (para busca de amigos)
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Contas bancárias — apenas o próprio dono
    match /contas/{contaId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Cartões de crédito — apenas o próprio dono
    match /cartoes/{cartaoId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Despesas — apenas o próprio dono
    match /despesas/{despesaId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Caixinhas
    match /caixinhas/{caixinhaId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Receitas
    match /receitas/{receitaId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Gastos previstos (manutenções, revisões, anuidades...) — apenas o próprio dono
    match /gastosPrevistos/{id} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Amizades
    match /amizades/{amizadeId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.solicitanteId ||
        request.auth.uid == resource.data.receptorId
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.solicitanteId;
      // Receptor pode aceitar/recusar; solicitante não pode auto-aceitar
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.receptorId;
    }
  }
}